  m_Script: {fileID: 11500000, guid: 4ae5437e113a64b7b52ec4ce7e400dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u0422\u0438\u0445\u0438\u0439 \u0432\u0435\u0447\u0435\u0440"
  hoverTint: {r: 1, g: 0.95, b: 0.85, a: 1}
  highlightTarget: {fileID: 0}
  clickPriority: 15
  message: "\u042D\u0442\u043E\u0442 \u043F\u043B\u0430\u043A\u0430\u0442 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u0437\u0434\u0435\u0441\u044C \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u043E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u0438\u0439
    \u0432\u0435\u0447\u0435\u0440 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430.
    \u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u0442\u043E\u0433\u0434\u0430 \u0442\u043E\u0436\u0435
    \u0448\u0451\u043B \u0434\u043E\u0436\u0434\u044C."
  extraMessages:
  - "\u0420\u044B\u0436\u0435\u0433\u043E \u0437\u043E\u0432\u0443\u0442 \u041F\u0435\u0440\u0441\u0438\u043A.
    \u0415\u0433\u043E \u043D\u0430\u0448\u043B\u0438 \u043D\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435
    \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u043C\u0430, \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D \u0435\u0449\u0451 \u043F\u043E\u043C\u0435\u0449\u0430\u043B\u0441\u044F
    \u0432 \u043B\u0430\u0434\u043E\u043D\u0438"
  - "\u0411\u0435\u043B\u0430\u044F \u0421\u043E\u043D\u044F \u0438 \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0439
    \u0422\u0443\u043C\u0430\u043D \u043F\u043E\u0441\u0435\u043B\u0438\u043B\u0438\u0441\u044C
    \u0437\u0434\u0435\u0441\u044C \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0434\u0435\u043B\u044E.
    \u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u044D\u0442\u043E\u0442 \u043F\u043E\u0434\u043E\u043A\u043E\u043D\u043D\u0438\u043A
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0430\u043D\u044F\u0442"
