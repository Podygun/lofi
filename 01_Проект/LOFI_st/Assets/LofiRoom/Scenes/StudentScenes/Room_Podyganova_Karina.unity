  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ae5437e113a64b7b52ec4ce7e400dd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "\u041E\u043D\u0430"
  hoverTint: {r: 1, g: 0.95, b: 0.85, a: 1}
  highlightTarget: {fileID: 0}
  clickPriority: 5
  message: "\u0421\u0438\u0434\u0438\u0442 \u0437\u0434\u0435\u0441\u044C \u043A\u0430\u0436\u0434\u044B\u0439
    \u0432\u0435\u0447\u0435\u0440. \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0434\u043E\u043F\u0438\u0441\u0430\u0442\u044C
    \u0433\u043B\u0430\u0432\u0443."
  extraMessages:
  - "\u041D\u0430\u0443\u0448\u043D\u0438\u043A\u0438 \u0441\u0442\u0430\u0440\u044B\u0435,
    \u043D\u043E \u0435\u0439 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043A\u0430\u043A
